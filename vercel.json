{
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm turbo build --filter=keeper-web",
  "outputDirectory": "apps/web/dist",

  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://keeper-platform-production.up.railway.app/api/$1" },

    { "source": "/mcp", "destination": "https://keeper-platform-production.up.railway.app/mcp" },
    { "source": "/mcp/(.*)", "destination": "https://keeper-platform-production.up.railway.app/mcp/$1" },

    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://keeper-platform-production.up.railway.app/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/(.*)",
      "destination": "https://keeper-platform-production.up.railway.app/.well-known/oauth-protected-resource/$1"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://keeper-platform-production.up.railway.app/.well-known/oauth-authorization-server"
    },

    { "source": "/oauth", "destination": "https://keeper-platform-production.up.railway.app/oauth" },
    { "source": "/oauth/(.*)", "destination": "https://keeper-platform-production.up.railway.app/oauth/$1" },

    {
      "source": "/:path((?!api/)(?!mcp(?:/|$))(?!oauth(?:/|$))(?!\\.well-known(?:/|$))(?!.*\\..+$).*)",
      "destination": "/index.html"
    }
  ],

  "redirects": [
    { "source": "/v1/:slug", "destination": "/d/:slug", "permanent": true },
    { "source": "/v1/:slug/board", "destination": "/d/:slug/board", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ke3p.com" }],
      "destination": "https://www.ke3p.com/$1",
      "permanent": true
    }
  ]
}
